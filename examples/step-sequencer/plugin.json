{
  "schemaVersion": 4,
  "manifest": {
    "name": "STEP SEQ 16",
    "version": "1.0.0",
    "type": "control-source",
    "author": "nanoTracker SDK",
    "description": "16-step single-lane MIDI sequencer. Cable its MIDI OUT to any instrument slot to drive melodic or rhythmic patterns independent of the tracker grid."
  },
  "requires": ["portsV4", "worklet-v3", "consumes-song-position"],
  "ports": {
    "outputs": [
      { "id": "midi-out", "label": "MIDI OUT", "kind": "midi" }
    ]
  },
  "dsp": {
    "processorName": "com.nanotracker-sdk.step-seq-16"
  },
  "parameters": [
    { "key": "gate_length", "label": "GATE",  "min": 0.05, "max": 1.0,  "default": 0.5, "step": 0.01 },
    { "key": "root_note",   "label": "ROOT",  "min": 0,    "max": 127,  "default": 60,  "step": 1 },
    { "key": "step_01",     "label": "1",     "min": 0,    "max": 1,    "default": 1,   "step": 1 },
    { "key": "step_02",     "label": "2",     "min": 0,    "max": 1,    "default": 0,   "step": 1 },
    { "key": "step_03",     "label": "3",     "min": 0,    "max": 1,    "default": 0,   "step": 1 },
    { "key": "step_04",     "label": "4",     "min": 0,    "max": 1,    "default": 1,   "step": 1 },
    { "key": "step_05",     "label": "5",     "min": 0,    "max": 1,    "default": 0,   "step": 1 },
    { "key": "step_06",     "label": "6",     "min": 0,    "max": 1,    "default": 0,   "step": 1 },
    { "key": "step_07",     "label": "7",     "min": 0,    "max": 1,    "default": 1,   "step": 1 },
    { "key": "step_08",     "label": "8",     "min": 0,    "max": 1,    "default": 0,   "step": 1 },
    { "key": "step_09",     "label": "9",     "min": 0,    "max": 1,    "default": 0,   "step": 1 },
    { "key": "step_10",     "label": "10",    "min": 0,    "max": 1,    "default": 1,   "step": 1 },
    { "key": "step_11",     "label": "11",    "min": 0,    "max": 1,    "default": 0,   "step": 1 },
    { "key": "step_12",     "label": "12",    "min": 0,    "max": 1,    "default": 0,   "step": 1 },
    { "key": "step_13",     "label": "13",    "min": 0,    "max": 1,    "default": 1,   "step": 1 },
    { "key": "step_14",     "label": "14",    "min": 0,    "max": 1,    "default": 0,   "step": 1 },
    { "key": "step_15",     "label": "15",    "min": 0,    "max": 1,    "default": 0,   "step": 1 },
    { "key": "step_16",     "label": "16",    "min": 0,    "max": 1,    "default": 1,   "step": 1 }
  ],
  "ui": {
    "layout": "flex",
    "controls": [
      {
        "type": "group",
        "style": "row",
        "children": [
          { "type": "toggle", "parameter": "step_01",  "label": "1"  },
          { "type": "toggle", "parameter": "step_02",  "label": "2"  },
          { "type": "toggle", "parameter": "step_03",  "label": "3"  },
          { "type": "toggle", "parameter": "step_04",  "label": "4"  },
          { "type": "toggle", "parameter": "step_05",  "label": "5"  },
          { "type": "toggle", "parameter": "step_06",  "label": "6"  },
          { "type": "toggle", "parameter": "step_07",  "label": "7"  },
          { "type": "toggle", "parameter": "step_08",  "label": "8"  },
          { "type": "toggle", "parameter": "step_09",  "label": "9"  },
          { "type": "toggle", "parameter": "step_10",  "label": "10" },
          { "type": "toggle", "parameter": "step_11",  "label": "11" },
          { "type": "toggle", "parameter": "step_12",  "label": "12" },
          { "type": "toggle", "parameter": "step_13",  "label": "13" },
          { "type": "toggle", "parameter": "step_14",  "label": "14" },
          { "type": "toggle", "parameter": "step_15",  "label": "15" },
          { "type": "toggle", "parameter": "step_16",  "label": "16" }
        ]
      },
      {
        "type": "group",
        "style": "row",
        "children": [
          { "type": "knob", "parameter": "gate_length", "label": "GATE" },
          { "type": "knob", "parameter": "root_note",   "label": "ROOT" }
        ]
      }
    ]
  }
}
